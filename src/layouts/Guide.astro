---
import "../styles/main.css";
import Sprite from "../components/Sprite.astro";
import Top from "../components/Top.astro";
import Footer from "../components/Footer.astro";
import Dialogs from "../components/Dialogs.astro";
import { SITE, THEME_IDS } from "../lib/site.js";

const { detail } = Astro.props;
const title = `${SITE.name} ${SITE.tagline}`;

const bootstrap = `
  document.documentElement.className = "js";
  try {
    var t = localStorage.getItem("theme");
    if (t === "random") {
      var themes = ${JSON.stringify(THEME_IDS)};
      t = themes[Math.floor(Math.random() * themes.length)];
    }
    if (t && /^[a-z][a-z-]*$/.test(t)) document.documentElement.dataset.theme = t;
  } catch (e) {}
`;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="robots" content="noindex, nofollow" />
    <meta name="referrer" content="no-referrer" />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#FAFAF8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#131313" media="(prefers-color-scheme: dark)" />
    <title>{title}</title>
    <meta name="description" content={SITE.description} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={SITE.description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site).href} />
    <meta name="twitter:card" content="summary" />
    <link rel="icon" href="/favicon.ico" />
    <script is:inline set:html={bootstrap} />
  </head>
  <body data-detail={detail}>
    <Sprite />
    <Top />
    <main>
      <slot />
    </main>
    <Footer />
    <Dialogs />
    <script src="../scripts/app.js"></script>
  </body>
</html>
