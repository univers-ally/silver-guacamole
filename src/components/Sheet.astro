---
const { id, title = "" } = Astro.props;
---
<dialog id={id} class="sheet-dialog" aria-labelledby={`${id}-title`}>
  <div class="sheet">
    <div class="handle" aria-hidden="true"></div>
    <div class="sheet-head">
      <slot name="heading"><h3 id={`${id}-title`}>{title}</h3></slot>
      <slot name="actions" />
      <button type="button" class="close" aria-label="Close">✕</button>
    </div>
    <slot />
  </div>
</dialog>
