---
// Pass `app` for a Farmland app: its rules are keyed by the app's id, not the promo's.
import Icon from "./Icon.astro";

const { app } = Astro.props;
---
<button
  type="button"
  class="info"
  data-open="rules"
  data-id={app?.id}
  data-name={app?.name}
  aria-haspopup="dialog"
>
  <Icon name="rules" />Rules
</button>
