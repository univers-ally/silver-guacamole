---
// Unlisted
// ?origin=<page> adds a link back to that page (scripts/donate.js).
import Plain from "../layouts/Plain.astro";

Astro.csp.insertDirective("img-src 'self' https://storage.ko-fi.com");
Astro.csp.insertStyleResource({ resource: "'unsafe-hashes'", kind: "attribute" });
// sha256 of the snippet's style value, "border:0px;height:36px;"
Astro.csp.insertStyleHash({ hash: "sha256-M3n1VHq3sgJa8Vf82f2/8MadJYlLQR98bhFcLgLCj2M=", kind: "attribute" });
---
<Plain title="Tip jar">
  <h1>Tip jar</h1>
  <p>Everything here is free and ad-free.<br/>If you really want to, you can leave a tip.</p>
  <p><a href='https://ko-fi.com/I6K327JIHT' target='_blank'><img height='36' style='border:0px;height:36px;' src='https://storage.ko-fi.com/cdn/kofi3.png?v=6' border='0' alt='Buy Me a Coffee at ko-fi.com' /></a></p>
  <p class="small">COMPLETELY OPTIONAL.</p>
  <p id="back-row" hidden><a id="back" href="/">Go Back</a></p>
  <script src="../scripts/donate.js"></script>
</Plain>
